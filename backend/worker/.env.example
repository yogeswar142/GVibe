# ─────────────────────────────────────────────────────────────
# GVibe Worker — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this to .dev.vars for local development (do NOT commit .dev.vars)
#
# Set production secrets via: npx wrangler secret put <KEY>

# URL of your hosted Node.js backend (ngrok for dev, Render/VPS for prod)
API_BASE_URL=https://levitative-unpresumptuously-claire.ngrok-free.dev

# Shared secret for Worker → API internal communication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=replace_with_a_strong_random_hex_string
